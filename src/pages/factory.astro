---
const site = Astro.site!.href.replace(/\/$/, '');

const bookLink = 'https://calendar.app.google/Y98DRH6TpULmfevM9';

const principles = [
  {
    icon: '🧩',
    title: 'Augment, don’t replace',
    desc: 'Your teams keep working in Excel, WhatsApp, Outlook and the ERP they already know. We build the intelligence layer on top. No migrations, no “new system” your floor will reject.',
  },
  {
    icon: '⚡',
    title: 'A first win you feel',
    desc: 'Every engagement is built around a first working tool your people use within weeks, not a slide deck. Trust is earned with a system that works, then we expand area by area.',
  },
  {
    icon: '📉',
    title: 'Measured by the bottom line',
    desc: 'Every solution is scored by hours saved, orders unblocked, and mistakes prevented. Not by tokens, demos, or hype.',
  },
  {
    icon: '🔒',
    title: 'Human in the loop',
    desc: 'AI drafts, sorts, and surfaces. Your people approve. Nothing goes to a customer, a supplier, or the production floor without a human decision where it matters.',
  },
];

const steps = [
  {
    n: '01',
    title: 'Mapping Day',
    desc: 'One focused day on site. A deep session with management, then structured interviews across departments: engineering, project management, sales, procurement, service. We map the real workflows — not the official ones — including the tools, the spreadsheets, and the security constraints.',
    out: 'Output: a mapping document with your full process map, a ranked list of AI opportunities by value and speed, the low-hanging fruit, a roadmap, and a project cost estimate.',
  },
  {
    n: '02',
    title: 'First win',
    desc: 'We pick the highest-value, fastest opportunity from the map and build it first. A working tool in the hands of one team, on real data, within weeks. Good enough to cover 80–90% of the need on day one.',
    out: 'Output: a live system your people actually use — and the proof that this works in your factory, not just in theory.',
  },
  {
    n: '03',
    title: 'Staged build',
    desc: 'We expand department by department, following the roadmap. Each stage ships a complete, working system before the next begins. Budgets are staged the same way — you never pay for a big bang.',
    out: 'Output: an organizational brain that grows one proven piece at a time.',
  },
  {
    n: '04',
    title: 'Training & embedding',
    desc: 'Frontal, on-site training for every team that touches a system — shoulder to shoulder, on their real work. Plus long-term support so the systems keep improving after we leave.',
    out: 'Output: a factory that runs the systems itself, with people who know why they work.',
  },
];

const groups = [
  {
    tag: 'ENGINEERING & DESIGN',
    icon: '📐',
    title: 'AI in the design room',
    intro: 'Where products are born is where AI compounds fastest — and where almost no factory has it.',
    items: [
      {
        title: 'CAD & 3D modeling copilots',
        desc: 'We connect your designers and engineers directly to AI through their existing tools — Rhino, 3D modeling environments, pattern and technical design software. The AI helps specify, model, and iterate on products at the prototype level: from a customer requirement to a first 3D concept in a fraction of the time.',
      },
      {
        title: 'Product specification assistant',
        desc: 'An agent that takes a customer request — “we need part X” — and drafts the technical specification: materials from your own database, tolerances, precedents from past projects, open questions for the customer. Engineers review and refine instead of starting from a blank page.',
      },
      {
        title: 'Knowledge base of past work',
        desc: 'Decades of drawings, specs, and solved problems usually live in veteran employees’ heads and in folders nobody searches. We turn that into a searchable engineering brain: “have we ever built something like this?” gets answered in seconds, with the files attached.',
      },
    ],
  },
  {
    tag: 'SALES, TENDERS & QUOTING',
    icon: '🎯',
    title: 'From inquiry to quote, faster than your competitors',
    intro: 'In manufacturing, the first credible quote usually wins. AI collapses days of quoting work into hours.',
    items: [
      {
        title: 'Tender & RFQ response automation',
        desc: 'An agent that scans incoming tenders and RFQs, extracts the technical requirements, matches them against your materials and solutions database, and drafts the technical response. Your team reviews a 90% draft instead of assembling one from scratch.',
      },
      {
        title: 'Quote generation with real production logic',
        desc: 'For machining and metalwork: an assistant that helps run the quoting chain — time studies, machine selection, tooling, materials — and produces a structured quote draft grounded in how your floor actually works.',
      },
      {
        title: 'Customer memory',
        desc: 'Every email thread, meeting, and past order for each customer, summarized and ready before a call. Your salespeople walk in knowing the full history — even for accounts they inherited.',
      },
    ],
  },
  {
    tag: 'OPERATIONS & PROJECT MANAGEMENT',
    icon: '⚙️',
    title: 'One view of every project',
    intro: 'Factories we meet run 40–70 parallel projects out of one Excel and one very tired project manager. The fix is not a new PM tool — it’s intelligence over the Excel you have.',
    items: [
      {
        title: 'Project dashboard over your existing files',
        desc: 'A live dashboard that reads your existing project Excel, your inbox, and your folders — and shows every project’s status, the tasks that are blocking, and a near-term work plan. One evening summary tells management what moved today and what is stuck.',
      },
      {
        title: 'ERP & supplier paperwork automation',
        desc: 'Purchase orders, supplier confirmations, delivery notes, invoices — the paperwork that eats your back office. AI reads the documents, cross-checks them against the ERP, drafts the responses, and flags mismatches for a human decision.',
      },
      {
        title: 'Daily morning briefing',
        desc: 'Every morning at 9:00, each manager gets a digest of their projects: what arrived in email overnight, which threads relate to which project, what needs an answer today. Nothing falls between the cracks because nobody had time to scroll.',
      },
    ],
  },
  {
    tag: 'FIELD SERVICE & WHATSAPP',
    icon: '📱',
    title: 'Intelligence over the WhatsApp chaos',
    intro: 'Field teams live in WhatsApp groups — one per project, full of free text and photos. We don’t fight that. We harvest it.',
    items: [
      {
        title: 'WhatsApp group intelligence',
        desc: 'Structured form links inside the same groups your technicians already use: they tap a link, upload photos, mark visit purpose and status. The data flows into the organizational system automatically — photos treated as first-class data, not lost scroll.',
      },
      {
        title: 'Daily group scanning & digest',
        desc: 'An agent sweeps all project groups every morning, detects what’s new, and produces a service digest per project: open issues, waiting-on-parts, escalations. Management sees the field without reading 40 groups.',
      },
      {
        title: 'Service report automation',
        desc: 'From the messages and photos a technician already sends, the system drafts the formal service report and files it against the right machine and customer. The technician confirms instead of typing.',
      },
    ],
  },
  {
    tag: 'EMAIL & OFFICE',
    icon: '📧',
    title: 'An inbox that sorts itself',
    intro: 'Applications teams, sales, and procurement run entire product journeys inside Outlook. AI turns that thread-jungle into structured work.',
    items: [
      {
        title: 'Outlook triage by project',
        desc: 'Every incoming email is read, classified, and attached to the right project or customer. “Which threads relate to this order?” becomes a click, not an archaeology dig.',
      },
      {
        title: 'Drafting with your house style',
        desc: 'Replies to routine requests — status updates, document requests, standard confirmations — drafted automatically in your tone and language (including Hebrew, English, and mixed threads), waiting for one-click approval.',
      },
    ],
  },
  {
    tag: 'THE ORGANIZATIONAL BRAIN',
    icon: '🧠',
    title: 'Where it all converges',
    intro: 'Each solution above is useful alone. Together, they feed one system — a brain that serves the whole organization, not one person.',
    items: [
      {
        title: 'Cross-department knowledge system',
        desc: 'WhatsApp data, email threads, ERP records, project files, and engineering knowledge feeding one connected system. Ask it a question in plain language — “what’s blocking the delivery for customer X?” — and get an answer with sources.',
      },
      {
        title: 'Management visibility',
        desc: 'A single management view: every project, every department, status, blockers, and a this-week plan. Plus one evening summary that replaces the “what happened today?” round of phone calls.',
      },
      {
        title: 'Prototype rescue',
        desc: 'Someone in your company already built a helpful tool — in Base44, Lovable, Power Automate, or a personal dashboard? That’s a signal, not a problem. We take these self-built prototypes and industrialize them into secure, organization-grade systems. Starting the mapping yourselves is half the way to a product.',
      },
    ],
  },
];

const security = [
  {
    title: 'Your cloud or on-premises',
    desc: 'Systems run in your environment — your Microsoft 365 tenant, your cloud account, or a local on-prem server when required. We also work with local open-source models for air-gapped or classified contexts.',
  },
  {
    title: 'No training on your data',
    desc: 'We work with enterprise-grade AI configurations where your data is not used to train anyone’s models. Data residency and retention are defined in writing before anything is built.',
  },
  {
    title: 'Defense-supplier ready',
    desc: 'We work with defense-sector manufacturers. Security constraints, human-in-the-loop checkpoints, and customer commitments are mapped on the Mapping Day and baked into every solution — third-party penetration testing included where needed.',
  },
];

const cases = [
  {
    name: 'Defense Manufacturer',
    tag: 'Tactical Gear · Israel',
    built: 'A full AI transformation at a veteran Israeli defense manufacturer (three decades of production, supplier to the IDF and NATO countries) that runs a large order book on Excel and paperwork. The engagement runs from ERP and supplier paperwork automation, through process mapping across engineering, project management, and tenders, up to connecting the design team to AI through a 3D-modeling MCP — AI that helps specify and build products at the prototype level.',
    outcome: 'A staged transformation, starting with a one-day on-site mapping across all departments and a ranked roadmap — with designers, project managers, and the tender team each getting AI built into the tools they already use.',
    quote: null,
    who: null,
  },
  {
    name: 'Ginger Insurance',
    tag: 'Insurtech',
    built: 'An AI agent for end customers that doesn’t just answer questions but takes real actions: it sends approval requests by email to both the customer and the company, and books live calls with case managers — with an eval mechanism and an isolated, secure embed inside Ginger’s system.',
    outcome: 'The agent is live and performs real actions in production, including opening requests and booking meetings.',
    quote: 'Wow. This is amazing. This is amazing.',
    who: 'Oshrat Ben Moshe, CEO and Founder, Ginger',
  },
  {
    name: 'JVP',
    tag: 'Venture Capital',
    built: 'An agent for the fund’s IR team that automatically produces a full briefing document on an investor: it pulls from the CRM, the web, and LinkedIn, cross-references everything, attaches quotes and sources, and outputs a ready document in the fund’s own format.',
    outcome: 'A report that took hours of manual work is now built in about five minutes, with factual accuracy of 95% and above. Presented to the fund’s partners and green-lit for expansion.',
    quote: 'this to me feels like you’ve figured it out. It looks great.',
    who: 'Lauren Kiel, Investor Relations, JVP',
  },
  {
    name: 'iPracticom',
    tag: 'Telecom',
    built: 'A “marketing brain” built on four connected skills (creative → content → scheduling → monitoring) over a wiki architecture, designed to replace an external marketing agency. The system produces live posts and graphics.',
    outcome: 'The system works in production, and the CEO asked to expand it into a company-wide organizational brain serving the support team as well.',
    quote: null,
    who: null,
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${site}/factory/#service`,
  url: `${site}/factory/`,
  name: 'AI Systems for Factories — Yuval Keshtcher',
  serviceType: 'AI consulting and implementation for manufacturing',
  inLanguage: 'en',
  description:
    'AI agent systems for low-tech factories and manufacturers: mapping day, quoting and tender automation, project dashboards, WhatsApp field-service intelligence, ERP paperwork automation, design-room AI, and an organizational brain — from mapping to full implementation.',
  provider: {
    '@type': 'Person',
    '@id': `${site}/#person`,
    name: 'Yuval Keshtcher',
    url: `${site}/`,
    image: `${site}/avatar.jpg`,
    jobTitle: 'AI Consultant & Implementer',
  },
  areaServed: ['Israel', 'Europe', 'Romania'],
};
---
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AI Systems for Factories — Yuval Keshtcher</title>
  <meta name="description" content="AI for low-tech manufacturers: quoting & tender automation, project dashboards over your Excel, WhatsApp field-service intelligence, design-room AI, and an organizational brain. From a one-day mapping to full implementation." />
  <link rel="canonical" href={`${site}/factory/`} />

  <!-- Open Graph -->
  <meta property="og:title" content="AI Systems for Factories — Yuval Keshtcher" />
  <meta property="og:description" content="The factory keeps running on Excel, WhatsApp and Outlook. We build the AI layer on top — from a one-day mapping to full implementation." />
  <meta property="og:image" content={`${site}/avatar.jpg`} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={`${site}/factory/`} />
  <meta name="theme-color" content="#000000" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <style is:inline>
    * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

    :root {
      --x-blue: #1d9bf0;
      --line: #2f3336;
      --muted: #71767b;
    }

    html, body { height: 100%; }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      min-height: 100vh;
      background: #000;
      color: #e7e9ea;
      display: flex;
      justify-content: center;
      padding: 56px 18px 64px;
      overflow-x: hidden;
      position: relative;
    }

    body::before {
      content: "";
      position: fixed;
      top: -260px;
      inset-inline: 0;
      margin: auto;
      width: 600px;
      height: 600px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(29,155,240,0.22) 0%, rgba(29,155,240,0) 70%);
      filter: blur(20px);
      z-index: 0;
      pointer-events: none;
      opacity: 0;
      animation: glowIn 1.4s ease-out 0.2s forwards;
    }
    @keyframes glowIn { to { opacity: 1; } }

    .container {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 760px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .fade {
      opacity: 0;
      transform: translateY(14px);
      animation: fadeUp 0.62s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }
    @keyframes fadeUp { to { opacity: 1; transform: translateY(0); } }

    /* --- hero --- */
    .kicker {
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 2.5px;
      color: var(--x-blue);
      text-transform: uppercase;
      margin-bottom: 16px;
      text-align: center;
    }
    h1 {
      font-size: 40px;
      font-weight: 800;
      line-height: 1.15;
      text-align: center;
      max-width: 640px;
      color: #fff;
    }
    .lead {
      font-size: 17px;
      color: #cfd2d4;
      text-align: center;
      max-width: 580px;
      line-height: 1.65;
      margin: 18px 0 8px;
    }
    .lead b { color: #fff; }
    .sublead {
      font-size: 15px;
      color: var(--muted);
      text-align: center;
      max-width: 540px;
      line-height: 1.6;
      margin-bottom: 26px;
    }

    /* --- buttons --- */
    .cta {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      min-height: 56px;
      padding: 14px 30px;
      background: var(--x-blue);
      color: #fff;
      border: none;
      border-radius: 999px;
      text-decoration: none;
      font-size: 16.5px;
      font-weight: 800;
      font-family: inherit;
      transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
      box-shadow: 0 8px 26px rgba(29,155,240,0.28);
    }
    .cta svg { width: 22px; height: 22px; fill: none; stroke: #fff; stroke-width: 2; }
    .cta:hover { transform: translateY(-2px); filter: brightness(1.08); box-shadow: 0 12px 32px rgba(29,155,240,0.36); }
    .cta:active { transform: translateY(0) scale(0.99); }

    /* --- sections --- */
    section { width: 100%; }
    .divider { width: 100%; height: 1px; background: var(--line); margin: 46px 0; border: none; }
    .section-title {
      font-size: 14px;
      font-weight: 700;
      color: var(--muted);
      letter-spacing: 0.6px;
      text-align: center;
      margin-bottom: 8px;
    }
    .section-head {
      font-size: 25px;
      font-weight: 800;
      color: #fff;
      text-align: center;
      line-height: 1.3;
      margin-bottom: 12px;
    }
    .section-sub {
      font-size: 15px;
      color: #cfd2d4;
      text-align: center;
      line-height: 1.65;
      max-width: 560px;
      margin: 0 auto 28px;
    }
    .section-sub b { color: #fff; }

    /* --- problem strip --- */
    .problem {
      background: #16181c;
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 26px 28px;
      font-size: 15.5px;
      line-height: 1.7;
      color: #d6d9db;
    }
    .problem b { color: #fff; }
    .problem .accent { color: var(--x-blue); font-weight: 700; }

    /* --- principle cards --- */
    .grid2 {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
      width: 100%;
    }
    .pcard {
      background: #16181c;
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 22px;
      transition: border-color 0.2s ease, transform 0.2s ease;
    }
    .pcard:hover { border-color: #3d4044; transform: translateY(-2px); }
    .pcard .icon {
      width: 46px; height: 46px; border-radius: 12px;
      background: rgba(29,155,240,0.10);
      border: 1px solid rgba(29,155,240,0.22);
      display: flex; align-items: center; justify-content: center;
      font-size: 23px; margin-bottom: 14px;
    }
    .pcard h3 { font-size: 17px; font-weight: 800; color: #fff; margin-bottom: 7px; }
    .pcard p { font-size: 14px; line-height: 1.6; color: #b8bcbf; }

    /* --- process steps --- */
    .steps { display: flex; flex-direction: column; gap: 16px; width: 100%; }
    .step {
      background: #16181c;
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 24px;
      display: grid;
      grid-template-columns: 58px 1fr;
      gap: 18px;
      transition: border-color 0.2s ease;
    }
    .step:hover { border-color: #3d4044; }
    .step .num {
      font-size: 22px;
      font-weight: 800;
      color: var(--x-blue);
      background: rgba(29,155,240,0.10);
      border: 1px solid rgba(29,155,240,0.22);
      border-radius: 14px;
      width: 58px; height: 58px;
      display: flex; align-items: center; justify-content: center;
    }
    .step h3 { font-size: 18px; font-weight: 800; color: #fff; margin-bottom: 6px; }
    .step p { font-size: 14.5px; line-height: 1.65; color: #c9cccf; }
    .step .out { margin-top: 10px; font-size: 13.5px; color: var(--x-blue); font-weight: 600; line-height: 1.55; }

    /* --- solution groups --- */
    .group { margin-bottom: 34px; }
    .group:last-child { margin-bottom: 0; }
    .group-head { display: flex; align-items: center; gap: 14px; margin-bottom: 6px; }
    .group-head .gicon {
      width: 44px; height: 44px; border-radius: 12px; flex: none;
      background: rgba(29,155,240,0.10);
      border: 1px solid rgba(29,155,240,0.22);
      display: flex; align-items: center; justify-content: center;
      font-size: 21px;
    }
    .group-tag {
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 1.5px;
      color: var(--x-blue);
    }
    .group-title { font-size: 20px; font-weight: 800; color: #fff; line-height: 1.3; }
    .group-intro { font-size: 14.5px; color: var(--muted); line-height: 1.6; margin: 10px 0 16px; }
    .sol-list { display: flex; flex-direction: column; gap: 12px; }
    .sol {
      background: #16181c;
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 20px 22px;
      transition: border-color 0.2s ease, transform 0.2s ease;
    }
    .sol:hover { border-color: #3d4044; transform: translateY(-2px); }
    .sol h4 { font-size: 16px; font-weight: 800; color: #fff; margin-bottom: 6px; }
    .sol p { font-size: 14.5px; line-height: 1.65; color: #c9cccf; }

    /* --- security --- */
    .sec-list { display: flex; flex-direction: column; gap: 12px; width: 100%; }
    .sec-item {
      background: #16181c;
      border: 1px solid var(--line);
      border-inline-start: 3px solid var(--x-blue);
      border-radius: 16px;
      padding: 20px 22px;
    }
    .sec-item h4 { font-size: 16px; font-weight: 800; color: #fff; margin-bottom: 6px; }
    .sec-item p { font-size: 14.5px; line-height: 1.65; color: #c9cccf; }

    /* --- case cards --- */
    .cases { display: flex; flex-direction: column; gap: 18px; width: 100%; }
    .case {
      background: #16181c;
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 24px;
      transition: border-color 0.2s ease, transform 0.2s ease;
    }
    .case:hover { border-color: #3d4044; transform: translateY(-2px); }
    .case-head { display: flex; align-items: baseline; gap: 10px; margin-bottom: 16px; flex-wrap: wrap; }
    .case-name { font-size: 20px; font-weight: 800; color: #fff; }
    .case-tag {
      font-size: 12.5px;
      font-weight: 700;
      color: var(--x-blue);
      background: rgba(29,155,240,0.12);
      padding: 3px 10px;
      border-radius: 999px;
    }
    .case-row { margin-bottom: 14px; }
    .case-row .k { font-size: 12.5px; font-weight: 800; color: var(--muted); letter-spacing: 0.5px; margin-bottom: 4px; }
    .case-row .v { font-size: 15px; line-height: 1.6; color: #d6d9db; }
    .quote { border-inline-start: 3px solid var(--x-blue); padding-inline-start: 14px; margin-top: 16px; }
    .quote p { font-size: 15.5px; line-height: 1.55; color: #e7e9ea; font-style: italic; }
    .quote .who { font-size: 13px; color: var(--muted); margin-top: 6px; font-style: normal; font-weight: 700; }

    /* --- logos --- */
    .logo-strip {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 22px 40px;
    }
    .logo-strip img {
      height: 30px;
      width: auto;
      filter: grayscale(1) brightness(0) invert(1) opacity(0.6);
      transition: filter 0.25s ease;
    }
    .logo-strip img.tall { height: 38px; }
    .logo-strip img:hover { filter: grayscale(1) brightness(0) invert(1) opacity(1); }
    .logo-word {
      font-weight: 800;
      font-size: 19px;
      color: #8a9099;
      letter-spacing: 0.3px;
      white-space: nowrap;
      transition: color 0.25s ease;
    }
    .logo-word.mono { letter-spacing: 2px; font-size: 16px; }
    .logo-word:hover { color: #e7e9ea; }
    .logo-mark { display: inline-flex; align-items: center; gap: 8px; }

    /* --- who --- */
    .who-card {
      background: #16181c;
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 26px;
      display: flex;
      gap: 20px;
      align-items: flex-start;
    }
    .who-card img {
      width: 72px; height: 72px; border-radius: 50%; object-fit: cover; flex: none;
      border: 1px solid var(--line);
      box-shadow: 0 0 0 4px rgba(29,155,240,0.10);
    }
    .who-card h3 { font-size: 18px; font-weight: 800; color: #fff; }
    .who-card .role { font-size: 13.5px; color: var(--x-blue); font-weight: 700; margin: 3px 0 10px; }
    .who-card p { font-size: 14.5px; line-height: 1.65; color: #c9cccf; }

    /* --- closing --- */
    .closing { text-align: center; }
    .closing h2 { font-size: 24px; font-weight: 800; color: #fff; margin-bottom: 10px; }
    .closing p { font-size: 15px; color: #cfd2d4; line-height: 1.6; max-width: 460px; margin: 0 auto 22px; }

    .footer { margin-top: 48px; text-align: center; }
    .footer .brand { font-weight: 800; font-size: 14px; letter-spacing: 0.4px; color: #e7e9ea; }
    .footer .sub { font-size: 12px; color: var(--muted); margin-top: 4px; }
    .footer a { color: var(--muted); text-decoration: none; }
    .footer a:hover { color: var(--x-blue); }
    .footer .brand a { color: #e7e9ea; }

    @media (max-width: 560px) {
      h1 { font-size: 30px; }
      .grid2 { grid-template-columns: 1fr; }
      .step { grid-template-columns: 1fr; }
      .step .num { width: 48px; height: 48px; font-size: 18px; }
      .case { padding: 20px; }
      .who-card { flex-direction: column; }
    }
    @media (max-width: 380px) {
      .logo-strip { gap: 18px 26px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .fade, body::before { animation: none; opacity: 1; transform: none; }
    }
  </style>
</head>
<body>
  <main class="container">

    <!-- HERO -->
    <div class="kicker fade" style="animation-delay:0.02s">AI for Manufacturing</div>
    <h1 class="fade" style="animation-delay:0.06s">AI Systems for Factories</h1>
    <p class="lead fade" style="animation-delay:0.12s">Your factory runs on Excel, WhatsApp groups, Outlook threads, and thirty years of know-how in people’s heads. <b>We build the AI layer on top of exactly that</b> — without changing how your teams work.</p>
    <p class="sublead fade" style="animation-delay:0.16s">From a one-day mapping to full implementation: quoting, tenders, project management, field service, design, and one organizational brain that connects it all.</p>
    <a class="cta fade" style="animation-delay:0.22s" href={bookLink} target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="3" y="4.5" width="18" height="16" rx="2.5"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="8" y1="2.5" x2="8" y2="6.5"/><line x1="16" y1="2.5" x2="16" y2="6.5"/></svg>
      Book a meeting
    </a>

    <!-- WHY FACTORIES -->
    <hr class="divider fade" style="animation-delay:0.3s" />
    <section class="fade" style="animation-delay:0.32s">
      <div class="section-title">WHY FACTORIES</div>
      <h2 class="section-head">The biggest AI upside is on the factory floor</h2>
      <div class="problem">
        Tech companies fight over the last 5% of productivity. Manufacturers are sitting on the first 50%. A typical mid-size factory we meet runs a <b>large and growing order book</b> on spreadsheets, notebooks, and email — <span class="accent">60–70 parallel projects in one Excel</span>, field updates buried in dozens of WhatsApp groups, quotes that take days while competitors answer in hours, and decades of engineering knowledge that lives only in veterans’ heads.
        <br /><br />
        None of that is a weakness. It means the processes already work — they’re just <b>starved of leverage</b>. AI is the first technology that can be layered on top of this reality without forcing a painful ERP migration or a new tool nobody on the floor will open. That’s exactly what we build.
      </div>
    </section>

    <!-- PRINCIPLES -->
    <hr class="divider fade" style="animation-delay:0.34s" />
    <section class="fade" style="animation-delay:0.36s">
      <div class="section-title">HOW WE THINK</div>
      <h2 class="section-head">Four rules for AI that survives contact with a factory</h2>
      <div class="grid2">
        {principles.map((p) => (
          <article class="pcard">
            <div class="icon">{p.icon}</div>
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- PROCESS -->
    <hr class="divider fade" style="animation-delay:0.38s" />
    <section class="fade" style="animation-delay:0.4s">
      <div class="section-title">THE PROCESS</div>
      <h2 class="section-head">From mapping to full implementation</h2>
      <p class="section-sub">Every engagement starts small, proves itself, and grows in stages. No big-bang projects, no year-one invoices for year-three value.</p>
      <div class="steps">
        {steps.map((s) => (
          <article class="step">
            <div class="num">{s.n}</div>
            <div>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
              <div class="out">{s.out}</div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- SOLUTIONS CATALOG -->
    <hr class="divider fade" style="animation-delay:0.42s" />
    <section class="fade" style="animation-delay:0.44s">
      <div class="section-title">THE CATALOG</div>
      <h2 class="section-head">What we build for factories</h2>
      <p class="section-sub">Every factory gets its own map — but these are the systems that come up again and again, department by department. Each one is a working solution we can build over the tools you already use.</p>
      {groups.map((g) => (
        <div class="group">
          <div class="group-head">
            <div class="gicon">{g.icon}</div>
            <div>
              <div class="group-tag">{g.tag}</div>
              <div class="group-title">{g.title}</div>
            </div>
          </div>
          <p class="group-intro">{g.intro}</p>
          <div class="sol-list">
            {g.items.map((it) => (
              <article class="sol">
                <h4>{it.title}</h4>
                <p>{it.desc}</p>
              </article>
            ))}
          </div>
        </div>
      ))}
    </section>

    <!-- SECURITY -->
    <hr class="divider fade" style="animation-delay:0.46s" />
    <section class="fade" style="animation-delay:0.48s">
      <div class="section-title">SECURITY & GOVERNANCE</div>
      <h2 class="section-head">Built for factories that can’t afford leaks</h2>
      <div class="sec-list">
        {security.map((s) => (
          <article class="sec-item">
            <h4>{s.title}</h4>
            <p>{s.desc}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- CASES -->
    <hr class="divider fade" style="animation-delay:0.5s" />
    <section class="fade" style="animation-delay:0.52s">
      <div class="section-title">SUCCESS STORIES</div>
      <h2 class="section-head">Built, shipped, and working in production</h2>
      <div class="cases">
        {cases.map((c) => (
          <article class="case">
            <div class="case-head">
              <span class="case-name">{c.name}</span>
              <span class="case-tag">{c.tag}</span>
            </div>
            <div class="case-row">
              <div class="k">WHAT WE BUILT</div>
              <div class="v">{c.built}</div>
            </div>
            <div class="case-row">
              <div class="k">THE OUTCOME</div>
              <div class="v">{c.outcome}</div>
            </div>
            {c.quote && (
              <div class="quote">
                <p>“{c.quote}”</p>
                <div class="who">— {c.who}</div>
              </div>
            )}
          </article>
        ))}
      </div>
    </section>

    <!-- LOGOS -->
    <hr class="divider fade" style="animation-delay:0.54s" />
    <section class="fade" style="animation-delay:0.56s">
      <div class="section-title">COMPANIES I'VE WORKED AND WORK WITH</div>
      <div class="logo-strip">
        <img src="/logos/ginger.svg" alt="Ginger" class="tall" />
        <img src="/logos/jvp.png" alt="JVP" />
        <img src="/logos/shenkar.svg" alt="Shenkar" class="tall" />
        <span class="logo-word">Diesenhaus</span>
        <span class="logo-mark"><img src="/logos/diviners.png" alt="Diviners" style="height:28px" /><span class="logo-word">Diviners</span></span>
        <span class="logo-word mono">IPRACTICOM</span>
        <span class="logo-word">Spark Founder Lab</span>
      </div>
    </section>

    <!-- WHO -->
    <hr class="divider fade" style="animation-delay:0.58s" />
    <section class="fade" style="animation-delay:0.6s">
      <div class="section-title">WHO'S BEHIND THIS</div>
      <div class="who-card">
        <img src="/avatar.jpg" alt="Yuval Keshtcher" />
        <div>
          <h3>Yuval Keshtcher</h3>
          <div class="role">AI Consultant & Implementer · with a senior engineering team</div>
          <p>I lead company-wide AI transformations — business mapping, identifying the highest-value opportunities, and building the AI layer on top of how your teams already work. Behind me is a senior full-stack engineering team specialized in building and embedding enterprise-grade AI agent systems, with experience across manufacturing, defense, telecom, insurance, and venture capital. A decade ago I founded UX Writing Hub, an international school with 1,000+ graduates, built and run entirely on automations — today I build those systems for organizations.</p>
        </div>
      </div>
    </section>

    <!-- CLOSING -->
    <hr class="divider fade" style="animation-delay:0.62s" />
    <section class="closing fade" style="animation-delay:0.64s">
      <h2>You have a factory. We have the know-how.</h2>
      <p>One short call to figure out where AI would actually move your bottom line — and whether a one-day mapping makes sense for you. No commitment.</p>
      <a class="cta" href={bookLink} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="3" y="4.5" width="18" height="16" rx="2.5"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="8" y1="2.5" x2="8" y2="6.5"/><line x1="16" y1="2.5" x2="16" y2="6.5"/></svg>
        Book a meeting
      </a>
    </section>

    <footer class="footer fade" style="animation-delay:0.68s">
      <div class="brand"><a href="/">yuvkesh</a></div>
      <div class="sub">Business AI with Yuval Keshtcher · <a href="/about-en/">About</a></div>
    </footer>
  </main>
</body>
</html>
