    outcome: 'המערכת עובדת בפרודקשן, והמנכ"ל ביקש להרחיב אותה למוח ארגוני לכל החברה, שישרת גם את צוות התמיכה.',
    quote: null,
    who: null,
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${site}/factory-he/#service`,
  url: `${site}/factory-he/`,
  name: 'מערכות AI למפעלים — יובל קשטכר',
  serviceType: 'ייעוץ והטמעת AI לתעשייה וייצור',
  inLanguage: 'he',
  description:
    'מערכות AI למפעלים ותעשייה מסורתית: יום אפיון, אוטומציה של הצעות מחיר ומכרזים, דשבורד פרויקטים מעל האקסל הקיים, אינטליגנציה על קבוצות וואטסאפ של שירות שטח, אוטומציה של ניירת מול ספקים, AI בחדר העיצוב, ומוח ארגוני אחד. מהאפיון ועד ההטמעה.',
  provider: {
    '@type': 'Person',
    '@id': `${site}/#person`,
    name: 'Yuval Keshtcher',
    alternateName: 'יובל קשטכר',
    url: `${site}/`,
    image: `${site}/avatar.jpg`,
    jobTitle: 'AI Consultant & Implementer',
  },
  areaServed: ['Israel'],
};
---
<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>מערכות AI למפעלים — יובל קשטכר</title>
  <meta name="description" content="AI לתעשייה מסורתית: אוטומציה של הצעות מחיר ומכרזים, דשבורד פרויקטים מעל האקסל, אינטליגנציה על וואטסאפ של שירות שטח, AI בחדר העיצוב ומוח ארגוני. מיום אפיון אחד ועד הטמעה מלאה." />
  <link rel="canonical" href={`${site}/factory-he/`} />
  <link rel="alternate" hreflang="he" href={`${site}/factory-he/`} />
  <link rel="alternate" hreflang="en" href={`${site}/factory/`} />
  <link rel="alternate" hreflang="x-default" href={`${site}/factory/`} />

  <!-- Open Graph -->
  <meta property="og:title" content="מערכות AI למפעלים — יובל קשטכר" />
  <meta property="og:description" content="המפעל ממשיך לרוץ על אקסל, וואטסאפ ואאוטלוק. אנחנו בונים את שכבת החוכמה מעל. מיום אפיון אחד ועד הטמעה מלאה." />
  <meta property="og:image" content={`${site}/avatar.jpg`} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={`${site}/factory-he/`} />
  <meta name="theme-color" content="#000000" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <style is:inline>
    * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

    :root {
      --x-blue: #1d9bf0;
      --line: #2f3336;
      --muted: #71767b;
    }

    html, body { height: 100%; }

    body {
      font-family: 'Heebo', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      min-height: 100vh;
      background: #000;
      color: #e7e9ea;
      display: flex;
      justify-content: center;
      padding: 56px 18px 64px;
      overflow-x: hidden;
      position: relative;
    }

    body::before {
      content: "";
      position: fixed;
      top: -260px;
      inset-inline: 0;
      margin: auto;
      width: 600px;
      height: 600px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(29,155,240,0.22) 0%, rgba(29,155,240,0) 70%);
      filter: blur(20px);
      z-index: 0;
      pointer-events: none;
      opacity: 0;
      animation: glowIn 1.4s ease-out 0.2s forwards;
    }
    @keyframes glowIn { to { opacity: 1; } }

    .container {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 760px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .fade {
      opacity: 0;
      transform: translateY(14px);
      animation: fadeUp 0.62s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }
    @keyframes fadeUp { to { opacity: 1; transform: translateY(0); } }

    /* --- lang toggle --- */
    .lang {
      align-self: flex-end;
      font-size: 13px;
      font-weight: 700;
      color: var(--muted);
      text-decoration: none;
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 6px 14px;
      margin-bottom: 22px;
      transition: color 0.2s ease, border-color 0.2s ease;
    }
    .lang:hover { color: #e7e9ea; border-color: #3d4044; }

    /* --- hero --- */
    .kicker {
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 1.5px;
      color: var(--x-blue);
      margin-bottom: 16px;
      text-align: center;
    }
    h1 {
      font-size: 40px;
      font-weight: 800;
      line-height: 1.2;
      text-align: center;
      max-width: 640px;
      color: #fff;
    }
    .lead {
      font-size: 17px;
      color: #cfd2d4;
      text-align: center;
      max-width: 580px;
      line-height: 1.7;
      margin: 18px 0 8px;
    }
    .lead b { color: #fff; }
    .sublead {
      font-size: 15px;
      color: var(--muted);
      text-align: center;
      max-width: 540px;
      line-height: 1.65;
      margin-bottom: 26px;
    }

    /* --- buttons --- */
    .cta {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      min-height: 56px;
      padding: 14px 30px;
      background: #25d366;
      color: #04210f;
      border: none;
      border-radius: 999px;
      text-decoration: none;
      font-size: 16.5px;
      font-weight: 800;
      font-family: inherit;
      transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
      box-shadow: 0 8px 26px rgba(37,211,102,0.22);
    }
    .cta svg { width: 22px; height: 22px; fill: #04210f; }
    .cta:hover { transform: translateY(-2px); filter: brightness(1.05); box-shadow: 0 12px 32px rgba(37,211,102,0.3); }
    .cta:active { transform: translateY(0) scale(0.99); }

    /* --- sections --- */
    section { width: 100%; }
    .divider { width: 100%; height: 1px; background: var(--line); margin: 46px 0; border: none; }
    .section-title {
      font-size: 14px;
      font-weight: 700;
      color: var(--muted);
      letter-spacing: 0.6px;
      text-align: center;
      margin-bottom: 8px;
    }
    .section-head {
      font-size: 25px;
      font-weight: 800;
      color: #fff;
      text-align: center;
      line-height: 1.35;
      margin-bottom: 12px;
    }
    .section-sub {
      font-size: 15px;
      color: #cfd2d4;
      text-align: center;
      line-height: 1.7;
      max-width: 560px;
      margin: 0 auto 28px;
    }
    .section-sub b { color: #fff; }

    /* --- problem strip --- */
    .problem {
      background: #16181c;
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 26px 28px;
      font-size: 15.5px;
      line-height: 1.8;
      color: #d6d9db;
    }
    .problem b { color: #fff; }
    .problem .accent { color: var(--x-blue); font-weight: 700; }

    /* --- principle cards --- */
    .grid2 {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
      width: 100%;
    }
    .pcard {
      background: #16181c;
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 22px;
      transition: border-color 0.2s ease, transform 0.2s ease;
    }
    .pcard:hover { border-color: #3d4044; transform: translateY(-2px); }
    .pcard .icon {
      width: 46px; height: 46px; border-radius: 12px;
      background: rgba(29,155,240,0.10);
      border: 1px solid rgba(29,155,240,0.22);
      display: flex; align-items: center; justify-content: center;
      font-size: 23px; margin-bottom: 14px;
    }
    .pcard h3 { font-size: 17px; font-weight: 800; color: #fff; margin-bottom: 7px; }
    .pcard p { font-size: 14px; line-height: 1.7; color: #b8bcbf; }

    /* --- process steps --- */
    .steps { display: flex; flex-direction: column; gap: 16px; width: 100%; }
    .step {
      background: #16181c;
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 24px;
      display: grid;
      grid-template-columns: 58px 1fr;
      gap: 18px;
      transition: border-color 0.2s ease;
    }
    .step:hover { border-color: #3d4044; }
    .step .num {
      font-size: 22px;
      font-weight: 800;
      color: var(--x-blue);
      background: rgba(29,155,240,0.10);
      border: 1px solid rgba(29,155,240,0.22);
      border-radius: 14px;
      width: 58px; height: 58px;
      display: flex; align-items: center; justify-content: center;
    }
    .step h3 { font-size: 18px; font-weight: 800; color: #fff; margin-bottom: 6px; }
    .step p { font-size: 14.5px; line-height: 1.7; color: #c9cccf; }
    .step .out { margin-top: 10px; font-size: 13.5px; color: var(--x-blue); font-weight: 600; line-height: 1.6; }

    /* --- solution groups --- */
    .group { margin-bottom: 34px; }
    .group:last-child { margin-bottom: 0; }
    .group-head { display: flex; align-items: center; gap: 14px; margin-bottom: 6px; }
    .group-head .gicon {
      width: 44px; height: 44px; border-radius: 12px; flex: none;
      background: rgba(29,155,240,0.10);
      border: 1px solid rgba(29,155,240,0.22);
      display: flex; align-items: center; justify-content: center;
      font-size: 21px;
    }
    .group-tag {
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.8px;
      color: var(--x-blue);
    }
    .group-title { font-size: 20px; font-weight: 800; color: #fff; line-height: 1.35; }
    .group-intro { font-size: 14.5px; color: var(--muted); line-height: 1.7; margin: 10px 0 16px; }
    .sol-list { display: flex; flex-direction: column; gap: 12px; }
    .sol {
      background: #16181c;
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 20px 22px;
      transition: border-color 0.2s ease, transform 0.2s ease;
    }
    .sol:hover { border-color: #3d4044; transform: translateY(-2px); }
    .sol h4 { font-size: 16px; font-weight: 800; color: #fff; margin-bottom: 6px; }
    .sol p { font-size: 14.5px; line-height: 1.7; color: #c9cccf; }

    /* --- security --- */
    .sec-list { display: flex; flex-direction: column; gap: 12px; width: 100%; }
    .sec-item {
      background: #16181c;
      border: 1px solid var(--line);
      border-inline-start: 3px solid var(--x-blue);
      border-radius: 16px;
      padding: 20px 22px;
    }
    .sec-item h4 { font-size: 16px; font-weight: 800; color: #fff; margin-bottom: 6px; }
    .sec-item p { font-size: 14.5px; line-height: 1.7; color: #c9cccf; }

    /* --- case cards --- */
    .cases { display: flex; flex-direction: column; gap: 18px; width: 100%; }
    .case {
      background: #16181c;
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 24px;
      transition: border-color 0.2s ease, transform 0.2s ease;
    }
    .case:hover { border-color: #3d4044; transform: translateY(-2px); }
    .case-head { display: flex; align-items: baseline; gap: 10px; margin-bottom: 16px; flex-wrap: wrap; }
    .case-name { font-size: 20px; font-weight: 800; color: #fff; }
    .case-tag {
      font-size: 12.5px;
      font-weight: 700;
      color: var(--x-blue);
      background: rgba(29,155,240,0.12);
      padding: 3px 10px;
      border-radius: 999px;
    }
    .case-row { margin-bottom: 14px; }
    .case-row .k { font-size: 12.5px; font-weight: 800; color: var(--muted); letter-spacing: 0.5px; margin-bottom: 4px; }
    .case-row .v { font-size: 15px; line-height: 1.7; color: #d6d9db; }
    .quote { border-inline-start: 3px solid var(--x-blue); padding-inline-start: 14px; margin-top: 16px; }
    .quote p { font-size: 15.5px; line-height: 1.6; color: #e7e9ea; font-style: italic; }
    .quote .who { font-size: 13px; color: var(--muted); margin-top: 6px; font-style: normal; font-weight: 700; }

    /* --- logos --- */
    .logo-strip {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 22px 40px;
    }
    .logo-strip img {
      height: 30px;
      width: auto;
      filter: grayscale(1) brightness(0) invert(1) opacity(0.6);
      transition: filter 0.25s ease;
    }
    .logo-strip img.tall { height: 38px; }
    .logo-strip img:hover { filter: grayscale(1) brightness(0) invert(1) opacity(1); }
    .logo-word {
      font-weight: 800;
      font-size: 19px;
      color: #8a9099;
      letter-spacing: 0.3px;
      white-space: nowrap;
      transition: color 0.25s ease;
    }
    .logo-word.mono { letter-spacing: 2px; font-size: 16px; }
    .logo-word:hover { color: #e7e9ea; }
    .logo-mark { display: inline-flex; align-items: center; gap: 8px; }

    /* --- who --- */
    .who-card {
      background: #16181c;
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 26px;
      display: flex;
      gap: 20px;
      align-items: flex-start;
    }
    .who-card img {
      width: 72px; height: 72px; border-radius: 50%; object-fit: cover; flex: none;
      border: 1px solid var(--line);
      box-shadow: 0 0 0 4px rgba(29,155,240,0.10);
    }
    .who-card h3 { font-size: 18px; font-weight: 800; color: #fff; }
    .who-card .role { font-size: 13.5px; color: var(--x-blue); font-weight: 700; margin: 3px 0 10px; }
    .who-card p { font-size: 14.5px; line-height: 1.75; color: #c9cccf; }

    /* --- closing --- */
    .closing { text-align: center; }
    .closing h2 { font-size: 24px; font-weight: 800; color: #fff; margin-bottom: 10px; }
    .closing p { font-size: 15px; color: #cfd2d4; line-height: 1.7; max-width: 460px; margin: 0 auto 22px; }

    .footer { margin-top: 48px; text-align: center; }
    .footer .brand { font-weight: 800; font-size: 14px; letter-spacing: 0.4px; color: #e7e9ea; }
    .footer .sub { font-size: 12px; color: var(--muted); margin-top: 4px; }
    .footer a { color: var(--muted); text-decoration: none; }
    .footer a:hover { color: var(--x-blue); }
    .footer .brand a { color: #e7e9ea; }

    @media (max-width: 560px) {
      h1 { font-size: 30px; }
      .grid2 { grid-template-columns: 1fr; }
      .step { grid-template-columns: 1fr; }
      .step .num { width: 48px; height: 48px; font-size: 18px; }
      .case { padding: 20px; }
      .who-card { flex-direction: column; }
    }
    @media (max-width: 380px) {
      .logo-strip { gap: 18px 26px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .fade, body::before { animation: none; opacity: 1; transform: none; }
    }
  </style>
</head>
<body>
  <main class="container">
    <a class="lang fade" style="animation-delay:0.02s" href="/factory/">English</a>

    <!-- HERO -->
    <div class="kicker fade" style="animation-delay:0.02s">AI לתעשייה</div>
    <h1 class="fade" style="animation-delay:0.06s">מערכות AI למפעלים</h1>
    <p class="lead fade" style="animation-delay:0.12s">המפעל שלך רץ על אקסלים, קבוצות וואטסאפ, שרשורים באאוטלוק ושלושים שנות ידע שיושבות בראש של האנשים. <b>אנחנו בונים את שכבת החוכמה בדיוק על זה</b>, בלי לשנות את איך שהצוותים שלך עובדים.</p>
    <p class="sublead fade" style="animation-delay:0.16s">מיום אפיון אחד ועד הטמעה מלאה: הצעות מחיר, מכרזים, ניהול פרויקטים, שירות שטח, חדר עיצוב, ומוח ארגוני אחד שמחבר את הכל.</p>
    <a class="cta fade" style="animation-delay:0.22s" href={waLink} target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 0 1 8.413 3.488 11.824 11.824 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 0 0 1.51 5.26l-.999 3.648 3.978-1.115zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
      דברו איתי בוואטסאפ
    </a>

    <!-- WHY FACTORIES -->
    <hr class="divider fade" style="animation-delay:0.3s" />
    <section class="fade" style="animation-delay:0.32s">
      <div class="section-title">למה דווקא מפעלים</div>
      <h2 class="section-head">הרווח הכי גדול מבינה מלאכותית נמצא על רצפת הייצור</h2>
      <div class="problem">
        חברות הייטק נלחמות על חמשת האחוזים האחרונים של פרודוקטיביות. מפעלים יושבים על חמישים הראשונים. מפעל בינוני טיפוסי שאנחנו פוגשים מנהל <b>ספר הזמנות גדול וגדל</b> על אקסלים, מחברות ומיילים. <span class="accent">60 עד 70 פרויקטים במקביל באקסל אחד</span>, עדכוני שטח קבורים בעשרות קבוצות וואטסאפ, הצעות מחיר שלוקחות ימים בזמן שמתחרים עונים תוך שעות, ועשרות שנות ידע הנדסי שחי רק בראש של הוותיקים.
        <br /><br />
        זאת לא חולשה. זה אומר שהתהליכים כבר עובדים, פשוט חסר להם מנוף. AI היא הטכנולוגיה הראשונה שאפשר להניח מעל המציאות הזאת, בלי מיגרציה כואבת של מערכות ובלי כלי חדש שאף אחד ברצפה לא יפתח. <b>זה בדיוק מה שאנחנו בונים.</b>
      </div>
    </section>

    <!-- PRINCIPLES -->
    <hr class="divider fade" style="animation-delay:0.34s" />
    <section class="fade" style="animation-delay:0.36s">
      <div class="section-title">איך אנחנו חושבים</div>
      <h2 class="section-head">ארבעה כללים למערכות AI ששורדות מגע עם מפעל</h2>
      <div class="grid2">
        {principles.map((p) => (
          <article class="pcard">
            <div class="icon">{p.icon}</div>
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- PROCESS -->
    <hr class="divider fade" style="animation-delay:0.38s" />
    <section class="fade" style="animation-delay:0.4s">
      <div class="section-title">התהליך</div>
      <h2 class="section-head">מהאפיון ועד ההטמעה</h2>
      <p class="section-sub">כל פרויקט מתחיל קטן, מוכיח את עצמו וגדל בשלבים. בלי פרויקטי ענק ובלי לשלם בשנה הראשונה על ערך של שנה שלישית.</p>
      <div class="steps">
        {steps.map((s) => (
          <article class="step">
            <div class="num">{s.n}</div>
            <div>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
              <div class="out">{s.out}</div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- SOLUTIONS CATALOG -->
    <hr class="divider fade" style="animation-delay:0.42s" />
    <section class="fade" style="animation-delay:0.44s">
      <div class="section-title">הקטלוג</div>
      <h2 class="section-head">מה אנחנו בונים למפעלים</h2>
      <p class="section-sub">כל מפעל מקבל מפה משלו, אבל אלה המערכות שחוזרות שוב ושוב, מחלקה אחרי מחלקה. כל אחת מהן היא פתרון עובד שנבנה מעל הכלים שכבר יש לכם.</p>
      {groups.map((g) => (
        <div class="group">
          <div class="group-head">
            <div class="gicon">{g.icon}</div>
            <div>
              <div class="group-tag">{g.tag}</div>
              <div class="group-title">{g.title}</div>
            </div>
          </div>
          <p class="group-intro">{g.intro}</p>
          <div class="sol-list">
            {g.items.map((it) => (
              <article class="sol">
                <h4>{it.title}</h4>
                <p>{it.desc}</p>
              </article>
            ))}
          </div>
        </div>
      ))}
    </section>

    <!-- SECURITY -->
    <hr class="divider fade" style="animation-delay:0.46s" />
    <section class="fade" style="animation-delay:0.48s">
      <div class="section-title">אבטחת מידע</div>
      <h2 class="section-head">בנוי למפעלים שלא יכולים להרשות לעצמם דליפה</h2>
      <div class="sec-list">
        {security.map((s) => (
          <article class="sec-item">
            <h4>{s.title}</h4>
            <p>{s.desc}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- CASES -->
    <hr class="divider fade" style="animation-delay:0.5s" />
    <section class="fade" style="animation-delay:0.52s">
      <div class="section-title">סיפורי הצלחה</div>
      <h2 class="section-head">נבנה, עלה לאוויר ועובד בפרודקשן</h2>
      <div class="cases">
        {cases.map((c) => (
          <article class="case">
            <div class="case-head">
              <span class="case-name">{c.name}</span>
              <span class="case-tag">{c.tag}</span>
            </div>
            <div class="case-row">
              <div class="k">מה בנינו</div>
              <div class="v">{c.built}</div>
            </div>
            <div class="case-row">
              <div class="k">התוצאה</div>
              <div class="v">{c.outcome}</div>
            </div>
            {c.quote && (
              <div class="quote">
                <p>"{c.quote}"</p>
                <div class="who">{c.who}</div>
              </div>
            )}
          </article>
        ))}
      </div>
    </section>

    <!-- LOGOS -->
    <hr class="divider fade" style="animation-delay:0.54s" />
    <section class="fade" style="animation-delay:0.56s">
      <div class="section-title">חברות שעבדתי ועובד איתן</div>
      <div class="logo-strip">
        <img src="/logos/ginger.svg" alt="Ginger" class="tall" />
        <img src="/logos/jvp.png" alt="JVP" />
        <img src="/logos/shenkar.svg" alt="Shenkar" class="tall" />
        <span class="logo-word">Diesenhaus</span>
        <span class="logo-mark"><img src="/logos/diviners.png" alt="Diviners" style="height:28px" /><span class="logo-word">Diviners</span></span>
        <span class="logo-word mono">IPRACTICOM</span>
        <span class="logo-word">Spark Founder Lab</span>
      </div>
    </section>

    <!-- WHO -->
    <hr class="divider fade" style="animation-delay:0.58s" />
    <section class="fade" style="animation-delay:0.6s">
      <div class="section-title">מי מאחורי זה</div>
      <div class="who-card">
        <img src="/avatar.jpg" alt="יובל קשטכר" />
        <div>
          <h3>יובל קשטכר</h3>
          <div class="role">יועץ ומטמיע AI · עם צוות פיתוח בכיר</div>
          <p>אני מוביל טרנספורמציות AI רוחביות בארגונים: אפיון עסקי, זיהוי ההזדמנויות עם הערך הכי גבוה, ובניית שכבת AI על איך שהצוותים כבר עובדים. מאחוריי צוות פיתוח בכיר שמתמחה בבנייה והטמעה של מערכות סוכני AI ברמה ארגונית, עם ניסיון בתעשייה, ביטחון, טלקום, ביטוח והון סיכון. לפני עשור הקמתי את UX Writing Hub, בית ספר בינלאומי עם יותר מאלף בוגרים, שרץ כולו על אוטומציות. היום אני בונה את המערכות האלה לארגונים.</p>
        </div>
      </div>
    </section>

    <!-- CLOSING -->
    <hr class="divider fade" style="animation-delay:0.62s" />
    <section class="closing fade" style="animation-delay:0.64s">
      <h2>יש לכם מפעל. לנו יש את הידע.</h2>
      <p>שיחה קצרה אחת כדי להבין איפה AI באמת יזיז את השורה התחתונה שלכם, והאם יום אפיון מתאים לכם. בלי התחייבות.</p>
      <a class="cta" href={waLink} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 0 1 8.413 3.488 11.824 11.824 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 0 0 1.51 5.26l-.999 3.648 3.978-1.115zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
        דברו איתי בוואטסאפ
      </a>
    </section>

    <footer class="footer fade" style="animation-delay:0.68s">
      <div class="brand"><a href="/">yuvkesh</a></div>
      <div class="sub">בינה מלאכותית עסקית עם יובל קשטכר · <a href="/about/">אודות</a></div>
    </footer>
  </main>
</body>
</html>
