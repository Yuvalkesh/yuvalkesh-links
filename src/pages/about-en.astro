---
const site = Astro.site!.href.replace(/\/$/, '');

const bookLink = 'https://calendar.app.google/Y98DRH6TpULmfevM9';

const stats = [
  { num: '+1,000', label: 'Graduates at the world’s biggest companies' },
  { num: '11', label: 'Companies in active engagement right now' },
  { num: 'Millions', label: 'Monthly impressions on content agents write' },
];

const cases = [
  {
    name: 'JVP',
    tag: 'Venture Capital',
    built: 'I built the fund’s IR team an agent that automatically produces a full briefing document on an investor (LP). It pulls from the CRM, the web and LinkedIn, cross-references everything, attaches quotes and sources, and outputs a ready document in the fund’s own format.',
    outcome: 'A report that took hours of manual work is now built in about five minutes, with factual accuracy of 95% and above. It was presented to the fund’s partners, including chairman Erel Margalit, and got the green light to expand.',
    quote: 'this to me feels like you’ve figured it out. It looks great.',
    who: 'Lauren Kiel, Investor Relations, JVP',
  },
  {
    name: 'Ginger Insurance',
    tag: 'Insurtech',
    built: 'I built an AI agent for end customers that doesn’t just answer questions but takes real actions. It sends an MRI approval request by email to both the customer and the company, and books a live call with a case manager. We also built an eval mechanism and an isolated embed inside Ginger’s system.',
    outcome: 'The agent went live and performs real actions in production, including opening requests and booking meetings with the customer.',
    quote: 'Wow. This is amazing. This is amazing.',
    who: 'Oshrat Ben Moshe, CEO and Founder, Ginger',
  },
  {
    name: 'iPracticom',
    tag: 'Telecom',
    built: 'I built a “marketing brain” based on four skills (creative → content → scheduling → monitoring) on a wiki architecture, designed to replace an external marketing agency. The system produces live posts and graphics.',
    outcome: 'The system works and produces posts in practice, and the CEO asked to expand it into a company-wide organizational brain that would also serve the support team.',
    quote: null,
    who: null,
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': `${site}/about-en/#profilepage`,
  url: `${site}/about-en/`,
  name: 'Yuval Keshtcher — AI Consultant & Implementer',
  inLanguage: 'en',
  mainEntity: {
    '@type': 'Person',
    '@id': `${site}/#person`,
    name: 'Yuval Keshtcher',
    alternateName: ['yuvkesh', 'יובל קשטכר'],
    url: `${site}/`,
    image: `${site}/avatar.jpg`,
    jobTitle: 'AI Consultant & Implementer',
    description: 'Builds and implements AI systems for businesses and organizations. From mapping to full implementation.',
    knowsAbout: ['Artificial Intelligence', 'AI Agents', 'Automation', 'Product', 'UX'],
    sameAs: [
      'https://x.com/Parzival_1991',
      'https://www.facebook.com/groups/agentil',
      'https://github.com/Yuvalkesh',
    ],
  },
};
---
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Yuval Keshtcher — AI Consultant & Implementer</title>
  <meta name="description" content="Builds and implements AI systems for businesses and organizations. From mapping to full implementation. Selected projects: JVP, Ginger, iPracticom." />
  <link rel="canonical" href={`${site}/about-en/`} />
  <link rel="alternate" hreflang="en" href={`${site}/about-en/`} />
  <link rel="alternate" hreflang="he" href={`${site}/about/`} />
  <link rel="alternate" hreflang="x-default" href={`${site}/about-en/`} />

  <!-- Open Graph -->
  <meta property="og:title" content="Yuval Keshtcher — AI Consultant & Implementer" />
  <meta property="og:description" content="Builds and implements AI systems for businesses and organizations. From mapping to full implementation." />
  <meta property="og:image" content={`${site}/avatar.jpg`} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={`${site}/about-en/`} />
  <meta name="theme-color" content="#000000" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <style is:inline>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    :root {
      --x-blue: #1d9bf0;
      --line: #2f3336;
      --muted: #71767b;
    }

    html, body { height: 100%; }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      min-height: 100vh;
      background: #000;
      color: #e7e9ea;
      display: flex;
      justify-content: center;
      padding: 56px 18px 64px;
      overflow-x: hidden;
      position: relative;
    }

    body::before {
      content: "";
      position: fixed;
      top: -260px;
      inset-inline: 0;
      margin: auto;
      width: 600px;
      height: 600px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(29,155,240,0.22) 0%, rgba(29,155,240,0) 70%);
      filter: blur(20px);
      z-index: 0;
      pointer-events: none;
      opacity: 0;
      animation: glowIn 1.4s ease-out 0.2s forwards;
    }
    @keyframes glowIn { to { opacity: 1; } }

    .container {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 680px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .fade {
      opacity: 0;
      transform: translateY(14px);
      animation: fadeUp 0.62s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }
    @keyframes fadeUp { to { opacity: 1; transform: translateY(0); } }

    /* --- lang toggle --- */
    .lang {
      align-self: flex-end;
      font-size: 13px;
      font-weight: 700;
      color: var(--muted);
      text-decoration: none;
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 6px 14px;
      margin-bottom: 22px;
      transition: color 0.2s ease, border-color 0.2s ease;
    }
    .lang:hover { color: #e7e9ea; border-color: #3d4044; }

    /* --- hero --- */
    .avatar {
      width: 104px;
      height: 104px;
      border-radius: 50%;
      object-fit: cover;
      background: #16181c;
      border: 1px solid var(--line);
      box-shadow: 0 0 0 4px rgba(29,155,240,0.10), 0 10px 40px rgba(0,0,0,0.6);
      display: block;
      margin-bottom: 18px;
    }
    .name {
      font-size: 24px;
      font-weight: 800;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .name .verified { width: 21px; height: 21px; fill: var(--x-blue); }
    .role {
      font-size: 16px;
      color: var(--x-blue);
      font-weight: 700;
      margin-top: 6px;
    }
    .lead {
      font-size: 16px;
      color: #cfd2d4;
      text-align: center;
      max-width: 480px;
      line-height: 1.6;
      margin: 14px 0 26px;
    }

    /* --- buttons --- */
    .cta {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      min-height: 56px;
      padding: 14px 30px;
      background: var(--x-blue);
      color: #03121f;
      border: none;
      border-radius: 999px;
      text-decoration: none;
      font-size: 16.5px;
      font-weight: 800;
      font-family: inherit;
      transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
      box-shadow: 0 8px 26px rgba(29,155,240,0.28);
    }
    .cta svg { width: 22px; height: 22px; fill: none; stroke: #03121f; stroke-width: 2; }
    .cta:hover { transform: translateY(-2px); filter: brightness(1.07); box-shadow: 0 12px 32px rgba(29,155,240,0.36); }
    .cta:active { transform: translateY(0) scale(0.99); }

    /* --- sections --- */
    section { width: 100%; }
    .divider {
      width: 100%;
      height: 1px;
      background: var(--line);
      margin: 44px 0;
      border: none;
    }
    .section-title {
      font-size: 14px;
      font-weight: 700;
      color: var(--muted);
      letter-spacing: 0.6px;
      text-align: center;
      margin-bottom: 24px;
    }

    /* --- stats --- */
    .stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
      width: 100%;
    }
    .stat {
      background: #16181c;
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 18px 12px;
      text-align: center;
    }
    .stat .num { font-size: 26px; font-weight: 800; color: #fff; line-height: 1.1; }
    .stat .lbl { font-size: 12.5px; color: var(--muted); margin-top: 8px; line-height: 1.4; }

    /* --- logos --- */
    .logo-strip {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 22px 40px;
    }
    .logo-strip img {
      height: 30px;
      width: auto;
      filter: grayscale(1) brightness(0) invert(1) opacity(0.6);
      transition: filter 0.25s ease;
    }
    .logo-strip img.tall { height: 38px; }
    .logo-strip img:hover { filter: grayscale(1) brightness(0) invert(1) opacity(1); }
    .logo-word {
      font-weight: 800;
      font-size: 19px;
      color: #8a9099;
      letter-spacing: 0.3px;
      white-space: nowrap;
      transition: color 0.25s ease;
    }
    .logo-word.mono { letter-spacing: 2px; font-size: 16px; }
    .logo-word:hover { color: #e7e9ea; }
    .logo-mark { display: inline-flex; align-items: center; gap: 8px; }

    /* --- four hats infographic --- */
    .four-hats-img {
      width: 100%;
      height: auto;
      display: block;
      border: 1px solid var(--line);
      border-radius: 16px;
    }

    /* --- case cards --- */
    .cases { display: flex; flex-direction: column; gap: 18px; width: 100%; }
    .case {
      background: #16181c;
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 24px;
      transition: border-color 0.2s ease, transform 0.2s ease;
    }
    .case:hover { border-color: #3d4044; transform: translateY(-2px); }
    .case-head { display: flex; align-items: baseline; gap: 10px; margin-bottom: 16px; flex-wrap: wrap; }
    .case-name { font-size: 21px; font-weight: 800; color: #fff; }
    .case-tag {
      font-size: 12.5px;
      font-weight: 700;
      color: var(--x-blue);
      background: rgba(29,155,240,0.12);
      padding: 3px 10px;
      border-radius: 999px;
    }
    .case-row { margin-bottom: 14px; }
    .case-row .k {
      font-size: 12.5px;
      font-weight: 800;
      color: var(--muted);
      letter-spacing: 0.5px;
      margin-bottom: 4px;
    }
    .case-row .v { font-size: 15px; line-height: 1.6; color: #d6d9db; }
    .quote {
      border-inline-start: 3px solid var(--x-blue);
      padding-inline-start: 14px;
      margin-top: 16px;
    }
    .quote p {
      font-size: 15.5px;
      line-height: 1.55;
      color: #e7e9ea;
      font-style: italic;
    }
    .quote .who { font-size: 13px; color: var(--muted); margin-top: 6px; font-style: normal; font-weight: 700; }

    /* --- closing --- */
    .closing { text-align: center; }
    .closing h2 { font-size: 22px; font-weight: 800; color: #fff; margin-bottom: 10px; }
    .closing p { font-size: 15px; color: #cfd2d4; line-height: 1.6; max-width: 420px; margin: 0 auto 22px; }

    .footer {
      margin-top: 48px;
      text-align: center;
    }
    .footer .brand { font-weight: 800; font-size: 14px; letter-spacing: 0.4px; color: #e7e9ea; }
    .footer .sub { font-size: 12px; color: var(--muted); margin-top: 4px; }
    .footer a { color: var(--muted); text-decoration: none; }
    .footer a:hover { color: var(--x-blue); }

    @media (max-width: 560px) {
      .stats { grid-template-columns: repeat(2, 1fr); }
      .name { font-size: 22px; }
      .case { padding: 20px; }
      .case-name { font-size: 19px; }
    }
    @media (max-width: 380px) {
      .logo-strip { gap: 18px 26px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .fade, body::before { animation: none; opacity: 1; transform: none; }
    }
  </style>
</head>
<body>
  <main class="container">
    <a class="lang fade" style="animation-delay:0.02s" href="/about/">עברית</a>

    <!-- HERO -->
    <img class="avatar fade" style="animation-delay:0.05s" src="/avatar.jpg" alt="Yuval Keshtcher" />
    <div class="name fade" style="animation-delay:0.12s">
      Yuval Keshtcher
      <svg class="verified" viewBox="0 0 24 24" aria-hidden="true"><path d="M22.5 12.5c0-1.58-.875-2.95-2.148-3.6.154-.435.238-.905.238-1.4 0-2.21-1.71-3.998-3.818-3.998-.47 0-.92.084-1.336.25C14.818 2.415 13.51 1.5 12 1.5s-2.816.917-3.437 2.25c-.415-.165-.866-.25-1.336-.25-2.11 0-3.818 1.79-3.818 4 0 .494.083.964.237 1.4-1.272.65-2.147 2.018-2.147 3.6 0 1.495.782 2.798 1.942 3.486-.02.17-.032.34-.032.514 0 2.21 1.708 4 3.818 4 .47 0 .92-.086 1.335-.25.62 1.334 1.926 2.25 3.437 2.25 1.512 0 2.818-.916 3.437-2.25.415.163.865.248 1.336.248 2.11 0 3.818-1.79 3.818-4 0-.174-.012-.344-.033-.513 1.158-.687 1.943-1.99 1.943-3.484zm-6.616-3.334l-4.334 6.5c-.145.217-.382.334-.625.334-.143 0-.288-.04-.416-.126l-.115-.094-2.415-2.415c-.293-.293-.293-.768 0-1.06s.768-.294 1.06 0l1.77 1.767 3.825-5.74c.23-.345.696-.436 1.04-.207.346.23.44.696.21 1.04z"/></svg>
    </div>
    <div class="role fade" style="animation-delay:0.18s">AI Consultant & Implementer · From mapping to full implementation</div>
    <p class="lead fade" style="animation-delay:0.24s">A decade ago I founded UX Writing Hub, the international school for UX writing, with more than a thousand graduates at the world’s biggest companies, and I ran the whole business on automations. When Claude Code arrived, every business solution I had in my head suddenly became possible. I built a content engine that brought millions of impressions and a community of thousands, and that’s where the clients came from, from advisory all the way to full implementation. Today I sit on your real business, find where AI actually moves the bottom line, and build the system with you until it works, and stays with you.</p>
    <a class="cta fade" style="animation-delay:0.3s" href={bookLink} target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="3" y="4.5" width="18" height="16" rx="2.5"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="8" y1="2.5" x2="8" y2="6.5"/><line x1="16" y1="2.5" x2="16" y2="6.5"/></svg>
      Book a meeting
    </a>

    <!-- STATS -->
    <hr class="divider fade" style="animation-delay:0.34s" />
    <section class="fade" style="animation-delay:0.36s">
      <div class="stats">
        {stats.map((s) => (
          <div class="stat">
            <div class="num">{s.num}</div>
            <div class="lbl">{s.label}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- LOGOS -->
    <hr class="divider fade" style="animation-delay:0.4s" />
    <section class="fade" style="animation-delay:0.42s">
      <div class="section-title">COMPANIES I'VE WORKED AND WORK WITH</div>
      <div class="logo-strip">
        <img src="/logos/ginger.svg" alt="Ginger" class="tall" />
        <img src="/logos/jvp.png" alt="JVP" />
        <img src="/logos/shenkar.svg" alt="Shenkar" class="tall" />
        <span class="logo-word">Diesenhaus</span>
        <span class="logo-mark"><img src="/logos/diviners.png" alt="Diviners" style="height:28px" /><span class="logo-word">Diviners</span></span>
        <span class="logo-word mono">IPRACTICOM</span>
        <span class="logo-word">Spark Founder Lab</span>
      </div>
    </section>

    <!-- METHOD: FOUR HATS (infographic) -->
    <hr class="divider fade" style="animation-delay:0.44s" />
    <section class="fade" style="animation-delay:0.45s">
      <img class="four-hats-img" src="/four-hats-en.svg" width="1600" height="1200" loading="lazy" alt="Four hats: Product & Service, Marketing, Sales and Operations — four places where AI moves the bottom line. Starts with mapping, a first win, all the way to full transformation." />
    </section>

    <!-- CASES -->
    <hr class="divider fade" style="animation-delay:0.46s" />
    <section class="fade" style="animation-delay:0.48s">
      <div class="section-title">SELECTED PROJECTS</div>
      <div class="cases">
        {cases.map((c) => (
          <article class="case">
            <div class="case-head">
              <span class="case-name">{c.name}</span>
              <span class="case-tag">{c.tag}</span>
            </div>
            <div class="case-row">
              <div class="k">WHAT I BUILT</div>
              <div class="v">{c.built}</div>
            </div>
            <div class="case-row">
              <div class="k">THE OUTCOME</div>
              <div class="v">{c.outcome}</div>
            </div>
            {c.quote && (
              <div class="quote">
                <p>“{c.quote}”</p>
                <div class="who">— {c.who}</div>
              </div>
            )}
          </article>
        ))}
      </div>
    </section>

    <!-- CLOSING -->
    <hr class="divider fade" style="animation-delay:0.52s" />
    <section class="closing fade" style="animation-delay:0.54s">
      <h2>You have a business. I have the know-how.</h2>
      <p>Let’s figure out together where AI will actually move the needle for you. A short call, no commitment.</p>
      <a class="cta" href={bookLink} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="3" y="4.5" width="18" height="16" rx="2.5"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="8" y1="2.5" x2="8" y2="6.5"/><line x1="16" y1="2.5" x2="16" y2="6.5"/></svg>
        Book a meeting
      </a>
    </section>

    <footer class="footer fade" style="animation-delay:0.58s">
      <div class="brand"><a href="/">yuvkesh</a></div>
      <div class="sub">Business AI with Yuval Keshtcher</div>
    </footer>
  </main>
</body>
</html>
