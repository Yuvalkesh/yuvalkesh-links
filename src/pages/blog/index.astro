---
import { getCollection } from 'astro:content';

const site = Astro.site!.href.replace(/\/$/, '');
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmt = (d: Date, lang: string) =>
  d.toLocaleDateString(lang === 'he' ? 'he-IL' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'FutureProof Agents',
  url: `${site}/blog/`,
  description: 'מאמרים על בינה מלאכותית עסקית, סוכני AI ובנייה עם כלים חדשים. מאת יובל קשטכר.',
  author: { '@type': 'Person', name: 'Yuval Keshtcher', url: site },
};
---
<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <script is:inline>(function(){var h=location.hostname;if(h==='futureproofagents.com'||h==='localhost'||h==='127.0.0.1')return;var p=location.pathname;if(p==='/'||p==='/index.html')p='/links/';location.replace('https://futureproofagents.com'+p+location.search+location.hash);})();</script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>מאמרים | FutureProof Agents</title>
  <meta name="description" content="מאמרים על בינה מלאכותית עסקית, סוכני AI ובנייה עם כלים חדשים. מאת יובל קשטכר." />
  <link rel="canonical" href={`${site}/blog/`} />
  <link rel="alternate" type="application/rss+xml" title="FutureProof Agents" href={`${site}/rss.xml`} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="מאמרים | FutureProof Agents" />
  <meta property="og:description" content="מאמרים על בינה מלאכותית עסקית, סוכני AI ובנייה עם כלים חדשים. מאת יובל קשטכר." />
  <meta property="og:url" content={`${site}/blog/`} />
  <meta property="og:image" content={`${site}/avatar.jpg`} />
  <meta name="theme-color" content="#000000" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root { --x-blue: #1d9bf0; --line: #2f3336; --muted: #71767b; }
    body {
      font-family: 'Heebo', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: #000;
      color: #e7e9ea;
      min-height: 100vh;
      padding: 48px 18px 64px;
      display: flex;
      justify-content: center;
    }
    .wrap { width: 100%; max-width: 680px; }
    .top-nav { margin-bottom: 36px; }
    .top-nav a { color: var(--x-blue); text-decoration: none; font-weight: 600; font-size: 15px; }
    .top-nav a:hover { text-decoration: underline; }
    h1 { font-size: 32px; font-weight: 800; margin-bottom: 8px; }
    .sub { color: var(--muted); font-size: 15.5px; margin-bottom: 36px; line-height: 1.5; }
    .posts { display: flex; flex-direction: column; gap: 16px; }
    .post {
      display: block;
      background: #16181c;
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 22px 24px;
      text-decoration: none;
      color: #e7e9ea;
      transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
    }
    .post:hover { transform: translateY(-2px); background: #1d1f23; border-color: #3d4044; }
    .post h2 { font-size: 20px; font-weight: 800; line-height: 1.35; margin-bottom: 6px; }
    .post p { color: #b8bcbf; font-size: 15px; line-height: 1.6; margin-bottom: 10px; }
    .post .row { display: flex; align-items: center; gap: 10px; color: var(--muted); font-size: 13px; }
    .badge {
      font-size: 11.5px;
      font-weight: 700;
      color: var(--x-blue);
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 1px 9px;
    }
    .empty { color: var(--muted); font-size: 16px; }
  </style>
</head>
<body>
  <main class="wrap">
    <nav class="top-nav"><a href="/">→ חזרה לעמוד הראשי</a></nav>
    <h1>מאמרים</h1>
    <p class="sub">בינה מלאכותית עסקית, סוכני AI ובנייה עם כלים חדשים.</p>
    <div class="posts">
      {posts.length === 0 && <p class="empty">עוד אין מאמרים. בקרוב.</p>}
      {posts.map((post) => (
        <a class="post" href={`/blog/${post.id}/`} dir={post.data.lang === 'he' ? 'rtl' : 'ltr'} lang={post.data.lang}>
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
          <div class="row">
            <span class="badge">{post.data.lang === 'he' ? 'עברית' : 'EN'}</span>
            <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate, post.data.lang)}</time>
          </div>
        </a>
      ))}
    </div>
  </main>
</body>
</html>
