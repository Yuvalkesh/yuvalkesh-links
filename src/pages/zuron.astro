const asks = [
  '10 עד 20 זוגות מלאים מכל סוג מכונה: השרטוט המקורי, השרטוט אחרי ההכנה, וקובץ המכונה הסופי',
  'אותו חלק בשתי גרסאות: הקובץ שיצא מהמתכנת והקובץ שבאמת רץ במכונה. הפער ביניהם הוא הידע שצריך ללמוד',
  'תיעוד הדיאלקט או מדריך התכנות של כל בקר ומכונה, ורשימת המכונות עם דגם, בקר ושנה',
  'טבלאות הפרמטרים לפי חומר ועובי, כולל פיצוי צריבה ופיצוי קרף. זה הנכס הכי שווה שכבר קיים אצלכם',
  'נתוני נפח: כמה עבודות בחודש, כמה מהן חוזרות, וכמה זמן לוקחת כל אחת',
