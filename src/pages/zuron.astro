---
import SiteFooter from '../components/SiteFooter.astro';
const site = Astro.site!.href.replace(/\/$/, '');

const waMsg = encodeURIComponent('היי יובל, קראתי את הדוח בעמוד צורון ואשמח לתאם שיחה');
const waLink = `https://wa.me/972526414555?text=${waMsg}`;
const sheetLink = 'https://docs.google.com/spreadsheets/d/1LiwDGgcsOOdPaa-spXuFDRWaEzIc-euseeG8Oeef7pg/edit';

const techs = [
  {
    tag: 'טכנולוגיה 1',
    title: 'צריבה פוטוכימית',
    out: 'artwork מפוצה לפוטופלוטר, בפורמט Gerber',
    body: 'כאן הפלט אינו G-code בכלל. מה שיוצא מהתהליך הוא שרטוט מפוצה שהולך לפוטופלוטר. הפיצוי נגזר מעובי החומר, בערך רבע מהעובי לכל צד, ומעליו יושבים step and repeat, רגיסטרציה בין היריעות וניצול שטח. מי שמתייחס לזה כאל "המרה לשפת מכונה" בונה את הדבר הלא נכון.',
  },
  {
    tag: 'טכנולוגיה 2',
    title: 'מיקרו חיתוך בלייזר',
    out: 'תוכנית חלק בסביבת ה CAD/CAM של יצרן המכונה',
    body: 'לייזר בהולכת סילון מים הוא עולם בפני עצמו. תוכנית החלק נוצרת בסביבה של יצרן המכונה או דרך פוסט פרוססור ייעודי, והידע היקר כאן הוא לא הגאומטריה אלא הפרמטרים: הספק, מספר מעברים, מהירות ופיצוי קרף לפי חומר ועובי.',
  },
  {
    tag: 'טכנולוגיה 3',
    title: 'עיבוד שבבי HSC וריתוך לייזר CNC',
    out: 'G-code בדיאלקט של הבקר',
    body: 'רק כאן מדובר בתוכנית מכונה במובן המקובל, וגם כאן לכל בקר דיאלקט משלו. זו הטכנולוגיה היחידה מבין השלוש שיש עליה כלים מדף, וזו גם הסיבה שכדאי לדבר עליה בנפרד מהשתיים האחרות.',
  },
];

const unknowns = [
  {
    n: '01',
    q: 'איזה אחוז מהעבודות הן חוזרות?',
    why: 'זו השאלה שמשנה את מחיר הפרויקט פי כמה. אחוז חזרתיות גבוה מאפשר גישה של אחזור והתאמה מהמאגר, שהיא זולה ובטוחה בהרבה מייצור מאפס. אחוז נמוך מחייב מנוע כללים ומודל חיזוי, וזה פרויקט אחר לגמרי. צריך מספר מתוך ה ERP, לא הערכה.',
  },
  {
    n: '02',
    q: 'האם לתוכנה שמייצרת היום את הקבצים יש ממשק תכנותי?',
    why: 'אם יש API או מצב batch, הדרך הזולה בעולם היא להפעיל אוטומטית את התוכנה שכבר מייצרת אצלכם קבצים מאושרים, במקום לבנות מחליף. אם אין, הגישה הזו נופלת לגמרי וכל התכנון משתנה.',
  },
  {
    n: '03',
    q: 'האם העריכות שהמפעיל עושה במכונה חוזרות למאגר?',
    why: 'אם המאגר שומר את הקובץ שיצא מהמתכנת ולא את הקובץ שבאמת רץ, אתם יושבים על דאטה שאינה אמת ייחוס. הפער בין שתי הגרסאות האלה הוא בדיוק הידע שאנחנו רוצים ללמוד, ובלעדיו לומדים את הדבר הלא נכון.',
  },
  {
    n: '04',
    q: 'מה מותר להוציא מהמפעל?',
    why: 'אתם ספק מורשה של משרד הביטחון ועובדים לפי AS9100. מדיניות אבטחת המידע היא לא הערת שוליים בסוף הפרויקט, היא האילוץ הראשון שקובע ארכיטקטורה, עלות ולוח זמנים. יש הבדל עצום בין מערכת שרצה בענן לבין מערכת שרצה כולה בתוך המפעל.',
  },
  {
    n: '05',
    q: 'מה הנוהל שלכם להכנסת כלי תוכנה חדש לתהליך ייצור?',
    why: 'בסביבת AS9100 ההסמכה של כלי חדש יכולה להיות חצי מלוח הזמנים. זה דבר שחייבים לדעת בהתחלה, כי גילוי שלו באמצע הפרויקט הוא מה שהופך פיילוט מוצלח לפיילוט שלא עולה לייצור.',
  },
];

const compare = [
