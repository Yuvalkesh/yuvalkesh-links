---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft && data.lang === 'he');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const morePosts = (await getCollection('blog', ({ data }) => !data.draft && data.lang === 'he'))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)
  .map((p) => ({
    slug: p.id,
    title: p.data.title,
    description: p.data.description,
    lang: p.data.lang,
    pubDate: p.data.pubDate,
  }));
---
<ArticleLayout
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  lang={post.data.lang}
  tags={post.data.tags}
  ogImage={post.data.ogImage}
  coverImage={post.data.coverImage}
  canonical={post.data.canonical}
  translationOf={post.data.translationOf}
  slug={post.id}
  headings={headings}
  faq={post.data.faq}
  morePosts={morePosts}
>
  <Content />
</ArticleLayout>
